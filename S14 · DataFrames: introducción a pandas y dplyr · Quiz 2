        "import pandas as pd\n",
        "\n",
        "# 1. Datos asignados en tu contexto\n",
        "mi_portafolio_dict = {\n",
        "    \"NVDA\": {\"cantidad\": 18, \"precio_compra\": 111},\n",
        "    \"AAPL\": {\"cantidad\": 10, \"precio_compra\": 239},\n",
        "    \"GOOGL\": {\"cantidad\": 14, \"precio_compra\": 290},\n",
        "    \"AMZN\": {\"cantidad\": 18, \"precio_compra\": 303}\n",
        "}\n",
        "\n",
        "mis_precios_dict = {\n",
        "    \"NVDA\": 139,\n",
        "    \"AAPL\": 302,\n",
        "    \"GOOGL\": 344,\n",
        "    \"AMZN\": 313\n",
        "}\n",
        "\n",
        "# Construcción del DataFrame\n",
        "tickers = list(mi_portafolio_dict.keys())\n",
        "cantidades = [mi_portafolio_dict[t][\"cantidad\"] for t in tickers]\n",
        "precios_compra = [mi_portafolio_dict[t][\"precio_compra\"] for t in tickers]\n",
        "precios_actuales = [mis_precios_dict[t] for t in tickers]\n",
        "\n",
        "df_reto = pd.DataFrame({\n",
        "    \"ticker\": tickers,\n",
        "    \"cantidad\": cantidades,\n",
        "    \"precio_compra\": precios_compra,\n",
        "    \"precio_actual\": precios_actuales\n",
        "})\n",
        "\n",
        "# 2. Agregar columnas calculadas\n",
        "df_reto[\"valor_actual\"] = df_reto[\"cantidad\"] * df_reto[\"precio_actual\"]\n",
        "df_reto[\"ganancia\"] = df_reto[\"valor_actual\"] - (df_reto[\"cantidad\"] * df_reto[\"precio_compra\"])\n",
        "df_reto[\"rendimiento\"] = (df_reto[\"ganancia\"] / (df_reto[\"cantidad\"] * df_reto[\"precio_compra\"])) * 100\n",
