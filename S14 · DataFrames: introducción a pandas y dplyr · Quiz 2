        "# 3. Filtrar activos en pérdida\n",
        "activos_en_perdida = df_reto[df_reto[\"ganancia\"] < 0]\n",
        "print(\"--- Activos en pérdida ---\")\n",
        "display(activos_en_perdida)\n",
        "\n",
        "# 4. Ordenar de mayor a menor rendimiento\n",
        "portafolio_ordenado = df_reto.sort_values(by=\"rendimiento\", ascending=False)\n",
        "print(\"\\n--- Portafolio ordenado por rendimiento (descendente) ---\")\n",
        "display(portafolio_ordenado)"
